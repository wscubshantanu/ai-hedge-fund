# AI Model Provider Configurations
# Set your OpenAI API key here or leave blank to run in offline deterministic mode
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o

# Optional: Financial APIs (defaults to free Yahoo Finance data)
POLYGON_API_KEY=your_polygon_key_here
FINANCIAL_MODELING_PREP_KEY=your_fmp_key_here

# Risk Parameters
MAX_POSITION_SIZE_PCT=0.20
MAX_PORTFOLIO_VAR_95=0.08
MAX_VOLATILITY_THRESHOLD=0.65
